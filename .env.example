# NOEMA CONSULTORA - ENVIRONMENT VARIABLES
# Copiar este archivo a .env para desarrollo local o agregar estas variables en Vercel Dashboard

# 1. Email Sending (Resend API)
# Obtén tu API Key en https://resend.com
RESEND_API_KEY=re_123456789_abcdefg

# 2. Correo de Notificaciones
# Correo donde el cliente/consultora recibirá los leads del formulario
NOTIFICATION_EMAIL=contacto@noemaconsultora.com.py

# 3. Correo Remitente Autorizado
# Debe coincidir con un dominio verificado en Resend
SENDER_EMAIL=Noema Consultora <contacto@noemaconsultora.com.py>

# 4. Fallback opcional (Web3Forms)
# Obtén tu clave en https://web3forms.com
WEB3FORMS_KEY=
